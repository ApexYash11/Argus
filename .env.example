# AI Spend Auditor — API Keys
# Copy this to .env and fill in your keys
# Both are optional — local fallback mode works without them

GROQ_API_KEY=
OPENROUTER_API_KEY=
# Optional: pin a free OpenRouter model. Default is openrouter/free (auto-routes
# to an available free model — recommended since free IDs churn frequently).
# Examples: qwen/qwen3-next-80b-a3b-instruct:free, openai/gpt-oss-20b:free
# OPENROUTER_MODEL=openrouter/free
